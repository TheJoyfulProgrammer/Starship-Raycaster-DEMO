    This project is my attempt to build a modern GPU-accelerated raycasting demo
    in the spirit of classic 90s "2.5D" shooters, with a single-deck ship map as
    the main game overlay. It's also a personal sandbox for learning Vulkan and
    SDL3, and a testbed for various palette-building and quantization techniques.

    The code is organized into a few main components:
    - main.cpp: SDL3 app entrypoint and event loop, forwarding to App.
    - starship_raycaster.hpp/cpp: The main application class, Vulkan setup,
        rendering loop, and game overlay logic.
    - star_shipgen.hpp/cpp: A BSP-based procedural ship map generator, producing
        a grid of "tiles" that the raycaster renders.
    - star_palette.hpp/cpp: CPU palette-building utilities, including a perceptual
        palette builder based on a GPU-accelerated histogram.

    The project is built with C++26, and uses the Vulkan graphics API for rendering
    and SDL3 for windowing and input. It should compile and run on Windows, Linux,
    and macOS (with Vulkan support).

    The code is licensed under the zlib License (see above), which allows for free
    use and modification with minimal restrictions. Attribution is appreciated but
    not required.

    The testbed of palette-building techniques is a key part of the project, and includes:
    - A GPU-accelerated histogram builder that computes a 33^3 color histogram of
      the rendered image.
    - A CPU palette builder that takes the histogram and produces a 256-color palette
      using a weighted median-cut algorithm.
    - Support for preset palettes (e.g. EGA/VGA) and various dithering algorithms
      (Floyd-Steinberg, Bayer matrix, etc.).
    - A final display pass that looks up palette indices to show the quantized image.
    
    The game overlay is a simple GPU raycaster that renders a 2D grid-based map of "tiles"
    into a 3D view. The map is generated by a BSP-based algorithm that creates rooms,
    corridors, and zones with different themes. The raycaster supports walls, doors,
    stairs, and sprites (for NPCs or decorations). The player can move around the map and
    interact with doors.
    
    The project is a work in progress and may contain rough edges or incomplete features.
    
    Enjoy exploring the code and the demo!
*/
#version 450

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set=0, binding=0) uniform sampler2D uSrc;

layout(set=0, binding=7) uniform sampler2D uBlueNoise;

// Dynamic storage buffers (offset chosen in vkCmdBindDescriptorSets)
layout(std430, set=0, binding=1) readonly buffer PaletteBuf { vec4 palette[256]; } pal;
layout(std430, set=0, binding=2) readonly buffer LutBuf     { uint lut[]; } lut;

// Output index image
layout(r8ui, set=0, binding=3) uniform writeonly uimage2D uIndex;

// Error buffer (size = 3 * width * vec4)
//  row 0: current scanline (y)
//  row 1: y+1
//  row 2: y+2
layout(std430, set=0, binding=5) buffer ErrBuf { vec4 err[]; } errBuf;

layout(push_constant) uniform PC
{
    uint width;
    uint height;
    uint colorsToUse;     // 2..256
    uint ditherMode;      // 0 none, 1 FS, 2 Atkinson, 3 Bayer, 4 JJN, 5 Stucki, 6 Riemersma, 7 BlueNoise, 8 FS-Luma, 9 FS-Block
    uint frameIndex;      // increments each frame (for animated noise)
    float ditherStrength; // 0..1 (applied in noise/ordered modes)
} pc;

float luma255(vec3 rgb255)
{
    // Rec.709-ish weights. Operates in 0..255 space.
    return dot(rgb255, vec3(0.2126, 0.7152, 0.0722));
}

uint lutIndexFromRgb8(uvec3 rgb)
{
    const uint N = 33u; // 33^3 LUT
    uvec3 q = (rgb * (N - 1u) + 127u) / 255u;
    return (q.r * N + q.g) * N + q.b;
}

uint quantizeIndex(vec3 rgb255)
{
    uvec3 rgb = uvec3(clamp(rgb255 + 0.5, 0.0, 255.0));
    return lut.lut[lutIndexFromRgb8(rgb)];
}

float hash12(vec2 p)
{
    vec3 p3 = fract(vec3(p.xyx) * 0.1031);
    p3 += dot(p3, p3.yzx + 33.33);
    return fract((p3.x + p3.y) * p3.z);
}

// Compact-ish 8x8 ordered threshold (0..63)
uint bayer8(ivec2 p)
{
    uint x = uint(p.x & 7);
    uint y = uint(p.y & 7);

    uint a = (x & 1u) | ((y & 1u) << 1u);
    uint b = ((x & 2u) >> 1u) | (y & 2u);
    uint c = ((x & 4u) >> 2u) | ((y & 4u) >> 1u);

    uint v = 0u;
    v |= (a << 0u);
    v |= (b << 2u);
    v |= (c << 4u);
    return v;
}

vec3 applyOrderedOrNoise(vec3 rgb255, ivec2 pix)
{
    if (pc.ditherStrength <= 0.0001) return rgb255;

    float n = 0.5;

    if (pc.ditherMode == 3u) // Ordered/Bayer
    {
        n = (float(bayer8(pix)) + 0.5) / 64.0;
    }
    else // BlueNoise (procedural; non-tiled + drift)
    {
        // frameIndex is expected to be pre-scaled on the CPU (slow drift). It may be 0 for static noise.
        float s = float(pc.frameIndex);

        // Two decorrelated hashes + a tiny ordered term. This keeps it "blue-noise-ish" without obvious tiling.
        float h0 = hash12(vec2(pix) + vec2(s * 0.071, s * 0.113));
        float h1 = hash12(vec2(pix.yx) + vec2(s * 0.131, s * 0.053) + 17.0);

        ivec2 op = pix + ivec2(int(pc.frameIndex & 7u), int((pc.frameIndex * 3u) & 7u));
        float t  = (float(bayer8(op)) + 0.5) / 64.0;

        n = fract(h0 * 0.65 + h1 * 0.35 + t * 0.50);
    }

    // Scale dither strength automatically for small palettes:
    // palScale ~= cbrt(256/colorsToUse). 256 -> 1.0, 8 -> ~3.2, 2 -> ~5.0
    float palScale = pow(256.0 / float(pc.colorsToUse), 1.0/3.0);
    palScale = clamp(palScale, 1.0, 6.0);

    float amp = pc.ditherStrength * 16.0 * palScale; // "feel" knob in 8-bit space
    rgb255 += (n - 0.5) * amp;
    return clamp(rgb255, 0.0, 255.0);
}

void quantizeParallel()
{
    ivec2 pix = ivec2(gl_GlobalInvocationID.xy);
    if (pix.x >= int(pc.width) || pix.y >= int(pc.height)) return;

    vec3 rgb255 = texelFetch(uSrc, pix, 0).rgb * 255.0;

    if (pc.ditherMode == 3u || pc.ditherMode == 7u)
        rgb255 = applyOrderedOrNoise(rgb255, pix);

    uint idx = quantizeIndex(rgb255);
    imageStore(uIndex, pix, uvec4(idx, 0, 0, 0));
}

uint errOfs(uint row, uint x) { return row * pc.width + x; }

void clearRow(uint row)
{
    uint w = pc.width;
    for (uint x = 0u; x < w; ++x) errBuf.err[errOfs(row, x)] = vec4(0.0);
}

void shiftRows()
{
    uint w = pc.width;
    for (uint x = 0u; x < w; ++x)
    {
        errBuf.err[errOfs(0u, x)] = errBuf.err[errOfs(1u, x)];
        errBuf.err[errOfs(1u, x)] = errBuf.err[errOfs(2u, x)];
        errBuf.err[errOfs(2u, x)] = vec4(0.0);
    }
}

void addErr(int x, vec3 e, float k, uint row)
{
    if (x < 0 || x >= int(pc.width)) return;
    errBuf.err[errOfs(row, uint(x))].xyz += e * k;
}

void ditherErrorDiffusion(uint mode)
{
    uint w = pc.width;
    uint h = pc.height;

    // Clear all rows
    for (uint i=0u;i<3u*w;++i) errBuf.err[i] = vec4(0.0);

    for (uint y=0u; y<h; ++y)
    {
        // row 2 already contains errors destined for y+2; row 1 for y+1; row 0 for current y.
        bool serp = (y & 1u) != 0u;
        int xs = serp ? int(w) - 1 : 0;
        int xe = serp ? -1 : int(w);
        int dx = serp ? -1 : 1;

        for (int x = xs; x != xe; x += dx)
        {
            ivec2 pix = ivec2(x, int(y));
            vec3 src255 = texelFetch(uSrc, pix, 0).rgb * 255.0;
            src255 += errBuf.err[errOfs(0u, uint(x))].xyz;
            src255 = clamp(src255, 0.0, 255.0);

            uint idx = quantizeIndex(src255);
            vec3 q255 = pal.palette[idx].rgb * 255.0;
            vec3 e = src255 - q255;

            // Luma-only FS: diffuse only luminance error (reduces color crawling in some scenes).
            if (mode == 8u)
            {
                float dy = luma255(src255) - luma255(q255);
                e = vec3(dy);
            }

            imageStore(uIndex, pix, uvec4(idx,0,0,0));

            if (mode == 1u || mode == 8u) // Floyd-Steinberg (denom 16)
            {
                addErr(x + dx*1, e, 7.0/16.0, 0u);
                addErr(x - dx*1, e, 3.0/16.0, 1u);
                addErr(x + 0,    e, 5.0/16.0, 1u);
                addErr(x + dx*1, e, 1.0/16.0, 1u);
            }
            else if (mode == 2u) // Atkinson (denom 8; does NOT distribute full error)
            {
                float k = 1.0/8.0;
                addErr(x + dx*1, e, k, 0u);
                addErr(x + dx*2, e, k, 0u);

                addErr(x - dx*1, e, k, 1u);
                addErr(x + 0,    e, k, 1u);
                addErr(x + dx*1, e, k, 1u);

                addErr(x + 0,    e, k, 2u);
            }
            else if (mode == 4u) // Jarvis-Judice-Ninke (denom 48)
            {
                float d = 48.0;
                // y row (right)
                addErr(x + dx*1, e, 7.0/d, 0u);
                addErr(x + dx*2, e, 5.0/d, 0u);

                // y+1
                addErr(x - dx*2, e, 3.0/d, 1u);
                addErr(x - dx*1, e, 5.0/d, 1u);
                addErr(x + 0,    e, 7.0/d, 1u);
                addErr(x + dx*1, e, 5.0/d, 1u);
                addErr(x + dx*2, e, 3.0/d, 1u);

                // y+2
                addErr(x - dx*2, e, 1.0/d, 2u);
                addErr(x - dx*1, e, 3.0/d, 2u);
                addErr(x + 0,    e, 5.0/d, 2u);
                addErr(x + dx*1, e, 3.0/d, 2u);
                addErr(x + dx*2, e, 1.0/d, 2u);
            }
            else if (mode == 5u) // Stucki (denom 42)
            {
                float d = 42.0;
                // y row (right)
                addErr(x + dx*1, e, 8.0/d, 0u);
                addErr(x + dx*2, e, 4.0/d, 0u);

                // y+1
                addErr(x - dx*2, e, 2.0/d, 1u);
                addErr(x - dx*1, e, 4.0/d, 1u);
                addErr(x + 0,    e, 8.0/d, 1u);
                addErr(x + dx*1, e, 4.0/d, 1u);
                addErr(x + dx*2, e, 2.0/d, 1u);

                // y+2
                addErr(x - dx*2, e, 1.0/d, 2u);
                addErr(x - dx*1, e, 2.0/d, 2u);
                addErr(x + 0,    e, 4.0/d, 2u);
                addErr(x + dx*1, e, 2.0/d, 2u);
                addErr(x + dx*2, e, 1.0/d, 2u);
            }
        }

        // Shift: y+1 becomes current, y+2 becomes y+1, clear y+2
        shiftRows();
    }
}

// "Block/tile" Floyd–Steinberg-ish dithering.
// Each workgroup processes a 16x16 tile, diffusing error only within the tile.
// This massively reduces the single-thread bottleneck of full-frame error diffusion,
// at the cost of minor seams at tile boundaries (usually subtle; great for speed tests).
const int TW = 16;
const int TH = 16;
const int ERR_ARR = TW + 2; // 1px padding on each side

void addTileErr(inout vec3 row[ERR_ARR], int tx, vec3 e, float k)
{
    if (tx < 0 || tx >= TW) return;
    row[tx + 1] += e * k;
}

void ditherBlockFS()
{
    // One invocation per workgroup does the whole tile.
    if (gl_LocalInvocationID.x != 0u || gl_LocalInvocationID.y != 0u) return;

    ivec2 base = ivec2(int(gl_WorkGroupID.x) * TW, int(gl_WorkGroupID.y) * TH);

    vec3 errCurr[ERR_ARR];
    vec3 errNext[ERR_ARR];
    for (int i = 0; i < ERR_ARR; ++i) { errCurr[i] = vec3(0.0); errNext[i] = vec3(0.0); }

    for (int ty = 0; ty < TH; ++ty)
    {
        int y = base.y + ty;
        if (y >= int(pc.height)) break;

        bool serp = (uint(y) & 1u) != 0u;
        int xs = serp ? (TW - 1) : 0;
        int xe = serp ? -1 : TW;
        int dx = serp ? -1 : 1;

        for (int tx = xs; tx != xe; tx += dx)
        {
            int x = base.x + tx;
            if (x < 0 || x >= int(pc.width)) continue;

            vec3 src255 = texelFetch(uSrc, ivec2(x, y), 0).rgb * 255.0;
            src255 += errCurr[tx + 1];
            src255 = clamp(src255, 0.0, 255.0);

            uint idx = quantizeIndex(src255);
            vec3 q255 = pal.palette[idx].rgb * 255.0;
            vec3 e = src255 - q255;

            imageStore(uIndex, ivec2(x, y), uvec4(idx, 0, 0, 0));

            // Floyd–Steinberg weights (mirrored for serpentine). Limited to the tile.
            addTileErr(errCurr, tx + dx*1, e, 7.0/16.0);
            addTileErr(errNext, tx - dx*1, e, 3.0/16.0);
            addTileErr(errNext, tx + 0,    e, 5.0/16.0);
            addTileErr(errNext, tx + dx*1, e, 1.0/16.0);
        }

        // Next row
        for (int i = 0; i < ERR_ARR; ++i) { errCurr[i] = errNext[i]; errNext[i] = vec3(0.0); }
    }
}

// Hilbert curve helpers for Riemersma-ish pass (sequential space-filling curve)
void rot(uint n, inout uint x, inout uint y, uint rx, uint ry)
{
    if (ry == 0u)
    {
        if (rx == 1u)
        {
            x = n - 1u - x;
            y = n - 1u - y;
        }
        uint t = x; x = y; y = t;
    }
}

void ditherRiemersma()
{
    uint w = pc.width;
    uint h = pc.height;

    uint N = 1u;
    uint m = max(w, h);
    while (N < m) N <<= 1u;

    uint total = N * N;

    const int K = 16;
    vec3 ring[K];
    float wgt[K];

    float sum = 0.0;
    for (int i=0;i<K;++i) { wgt[i] = pow(0.5, float(i+1)); sum += wgt[i]; ring[i] = vec3(0.0); }
    for (int i=0;i<K;++i) wgt[i] /= sum;

    for (uint i = 0u; i < total; ++i)
    {
        uint t = i;
        uint x = 0u, y = 0u;
        for (uint s = 1u; s < N; s <<= 1u)
        {
            uint rx = 1u & (t >> 1u);
            uint ry = 1u & (t ^ rx);
            rot(s, x, y, rx, ry);
            x += s * rx;
            y += s * ry;
            t >>= 2u;
        }

        if (x >= w || y >= h) continue;
        ivec2 pix = ivec2(int(x), int(y));

        vec3 src255 = texelFetch(uSrc, pix, 0).rgb * 255.0;

        vec3 acc = vec3(0.0);
        for (int k=0;k<K;++k) acc += ring[k] * wgt[k];
        src255 = clamp(src255 + acc, 0.0, 255.0);

        uint idx = quantizeIndex(src255);
        vec3 q255 = pal.palette[idx].rgb * 255.0;
        vec3 e = src255 - q255;

        imageStore(uIndex, pix, uvec4(idx,0,0,0));

        for (int k=K-1;k>0;--k) ring[k] = ring[k-1];
        ring[0] = e;
    }
}

void main()
{
	// Block/tile FS runs one invocation per workgroup (still parallel across tiles).
	if (pc.ditherMode == 9u)
	{
		ditherBlockFS();
		return;
	}

    // Fast modes (fully parallel per pixel):
    if (pc.ditherMode == 0u || pc.ditherMode == 3u || pc.ditherMode == 7u)
    {
        quantizeParallel();
        return;
    }

    // Slow modes: one invocation does the full frame.
    if (gl_GlobalInvocationID.x != 0u || gl_GlobalInvocationID.y != 0u) return;

    if (pc.ditherMode == 6u)
        ditherRiemersma();
    else
        ditherErrorDiffusion(pc.ditherMode);
}
